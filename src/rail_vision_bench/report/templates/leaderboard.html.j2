<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; }
    table { border-collapse: collapse; }
    th, td { border: 1px solid #999; padding: 0.3rem 0.6rem; text-align: right; }
    th:first-child, td:first-child, td:nth-child(2), td:nth-child(3) { text-align: left; }
  </style>
</head>
<body>
  <h1>{{ title }}</h1>
  <p>Generated at {{ generated_at }}</p>
  <table>
    <thead>
      <tr>
        <th>model</th>
        <th>mode</th>
        <th>split</th>
        <th>headline_score</th>
        <th>detection_f1</th>
        <th>label_cer</th>
        <th>state_accuracy</th>
        <th>route_f1</th>
        <th>ece</th>
        <th>latency_p95_ms</th>
        <th>cost_usd</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        <td>{{ row.model }}</td>
        <td>{{ row.mode }}</td>
        <td>{{ row.split }}</td>
        <td>{{ row.headline_score }}</td>
        <td>{{ row.detection_f1 }}</td>
        <td>{{ row.label_cer }}</td>
        <td>{{ row.state_accuracy }}</td>
        <td>{{ row.route_f1 }}</td>
        <td>{{ row.ece }}</td>
        <td>{{ row.latency_p95_ms }}</td>
        <td>{{ row.cost_usd }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
