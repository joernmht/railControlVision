          "default": null,
          "title": "Confidence"
        },
        "occupancy": {
          "$ref": "#/$defs/Occupancy",
          "default": "unknown"
        },
        "route_set": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fahrstrassenausleuchtung, independent of occupancy.",
          "title": "Route Set"
