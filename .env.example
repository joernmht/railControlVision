# Copy to .env and fill in what you use. Every key here is read by rail_vision_bench.settings.Settings
# (tests assert this file and SETTINGS_ENV_KEYS name the same 16 keys). Never commit .env.

# Claude API key, read by the anthropic SDK (providers/claude.py)
ANTHROPIC_API_KEY=
# OpenAI API key, read by the openai SDK (providers/openai_compat.py)
OPENAI_API_KEY=
# base URL of any OpenAI-compatible server, e.g. a local vLLM endpoint (providers/openai_compat.py)
OPENAI_BASE_URL=
# Gemini API key, read by the google-genai SDK (providers/gemini.py)
GOOGLE_API_KEY=
# Mistral / Pixtral API key, read by the mistralai SDK (providers/mistral.py)
MISTRAL_API_KEY=
# Ollama server for local open-weight VLMs, read by the ollama client (default http://localhost:11434)
OLLAMA_HOST=
# enable LangSmith tracing of agent runs (true/false), read by langsmith
LANGSMITH_TRACING=
# LangSmith API key, read by langsmith
LANGSMITH_API_KEY=
# LangSmith project name, read by langsmith (default rail-vision-bench)
LANGSMITH_PROJECT=
# MLflow tracking server URI, read by the mlflow tracker (tracking/mlflow_tracker.py)
MLFLOW_TRACKING_URI=
# Hugging Face token for dataset publishing/download, read by huggingface_hub (dataset/hub.py)
HF_TOKEN=
# dataset root used by the bench itself (default data)
RVB_DATA_DIR=
# run-directory root used by `bench run` (default runs)
RVB_RUNS_DIR=
# bind host of the real-time harness (`bench serve`, default 127.0.0.1)
RVB_HARNESS_HOST=
# bind port of the real-time harness (`bench serve`, default 8000)
RVB_HARNESS_PORT=
# log level of the bench itself (default INFO)
RVB_LOG_LEVEL=
